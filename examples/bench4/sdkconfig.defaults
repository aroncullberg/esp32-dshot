CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_DSHOT_DEFAULT_D600=y
CONFIG_DSHOT_DEFAULT_BIDIRECTIONAL=y
CONFIG_DSHOT_DEFAULT_FRAME_HZ=1000
CONFIG_DSHOT_DEFAULT_TASK_PRIORITY=20
CONFIG_DSHOT_DEFAULT_TASK_CORE=1
CONFIG_DSHOT_STAGE_PROFILING=y
CONFIG_DSHOT_STAGE_PROFILE_INTERVAL=16
CONFIG_DSHOT_DEFAULT_STARTUP_LOW_MS=300
